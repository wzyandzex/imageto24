{
  "name": "imageto24",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A browser-based image upscaler. Free, open-source, privacy-first — no image bytes ever leave your device.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.515.0",
    "onnxruntime-web": "^1.21.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "wrangler": "^4.20.0"
  }
}
