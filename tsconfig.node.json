{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/cloud-temporal-server.ts",
    "scripts/cloud-temporal-deps.ts",
    "src/upng-js.d.ts",
    "src/gifenc.d.ts",
    "src/pngjs.d.ts"
  ]
}


