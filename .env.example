# Cloudflare credentials — required for `npm run cf:deploy` (manual deploys).
# The GitHub Actions deploy uses these as repository secrets instead.
#
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# using the "Edit Cloudflare Workers" template (covers Pages).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# AI model assets on Cloudflare R2 (ADR-0004). These are NOT bundled into the
# Pages deployment; the app fetches them lazily on first AI use and caches them
# in IndexedDB (issue #6). Provide an absolute https URL to the R2 object.
# Required for AI Enhance mode — without it, AI mode reports "unavailable".
#
# The general (photo) model is the default first load. The anime model (~18MB,
# ADR-0003) loads lazily only when anime/illustration content is detected or the
# user manually selects it, so a photo-only visitor never downloads it (#7).
VITE_MODEL_GENERAL_URL=
VITE_MODEL_ANIME_URL=

# Optional independent GPU service for v5 cloud temporal enhancement. Leave empty
# in local development to use the deterministic no-network fake tracer; set to an
# HTTPS service base URL in environments that should upload original animations.
#
# Local free host (zero cost — no GPU, no paid API):
#   npm run cloud:temporal
#   VITE_CLOUD_TEMPORAL_ENDPOINT=http://127.0.0.1:8787
#
# Host-side (not VITE_) optional:
#   CLOUD_TEMPORAL_ENHANCER=temporal-consistency  # default: Lanczos + neighbour blend
#   CLOUD_TEMPORAL_ENHANCER=lanczos               # pure per-frame Lanczos
#   CLOUD_TEMPORAL_PORT=8787
#   CLOUD_TEMPORAL_RATE_MAX=30
#   CLOUD_TEMPORAL_RATE_WINDOW_MS=60000
VITE_CLOUD_TEMPORAL_ENDPOINT=
